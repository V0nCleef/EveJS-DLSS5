class SystemMenu(object):

    def ApplyGraphicsSettings(self):

        @SHARED:native_nr_bridge@

        # Keep an unfinished transition across calls. An automatic OFF after a
        # failed apply is not a new manual preference on the next attempt.
        transitionState = getattr(gfxsettings, '_dlss5NRTransitionV13', None)
        if transitionState is None:
            transitionState = {'preferenceCaptured': False, 'needsRearm': False, 'observedSnapshot': None}
            gfxsettings._dlss5NRTransitionV13 = transitionState

        def rememberManualPreference(snapshot):
            previous = transitionState['observedSnapshot']
            if previous is not None and snapshot is not None and snapshot['state'] != 0:
                if snapshot['addonEpoch'] == previous['addonEpoch'] and snapshot['toggleSequence'] > previous['toggleSequence']:
                    gfxsettings._dlss5NRWantedV13 = 'ON' if snapshot['state'] == 2 else 'OFF'
            transitionState['observedSnapshot'] = snapshot

        def sameNativeState(before, after):
            return before is not None and after is not None and all(before[key] == after[key] for key in ('state', 'stateSequence', 'toggleSequence', 'addonEpoch'))

        def finishTransition():
            transitionState['preferenceCaptured'] = False
            transitionState['needsRearm'] = False
            transitionState['observedSnapshot'] = None

        def waitForGraphicsDeviceReady(targetTechnique):
            readinessPolls = 0
            while @LOCAL:ready_condition@:
                if readinessPolls >= 400:
                    logger.error('DLSS5 guard v13: renderer did not become ready within 400 polls; leaving NR unrearmed')
                    return False
                blue.synchro.SleepWallclock(25)
                readinessPolls += 1
            return True

        def applyGraphicsSettingsPass():
            @LOCAL:graphics_setup@

            if transitionState['preferenceCaptured']:
                rememberManualPreference(readDLSS5NativeSnapshot())
            currentUpscalingTechnique = @LOCAL:current_query@
            pendingUpscalingTechnique = gfxsettings.GetPendingOrCurrent(gfxsettings.GFX_UPSCALING_TECHNIQUE)
            pendingUpscalingSetting = gfxsettings.GetPendingOrCurrent(gfxsettings.GFX_UPSCALING_SETTING)
            pendingFrameGeneration = gfxsettings.GetPendingOrCurrent(gfxsettings.GFX_FRAMEGENERATION_ENABLED)
            hasPendingUpscalingChange = pendingUpscalingTechnique != @LOCAL:target_getter@ or pendingUpscalingSetting != @LOCAL:preset_getter@ or pendingFrameGeneration != @LOCAL:framegen_getter@
            resourceSettings = (gfxsettings.GFX_SHADER_QUALITY, gfxsettings.GFX_TEXTURE_QUALITY)
            hasPendingResourceChange = any(gfxsettings.GetPendingOrCurrent(key) != gfxsettings.Get(key) for key in resourceSettings)
            involvesDLSS = currentUpscalingTechnique == gfxsettings.GFX_UPSCALING_TECHNIQUE_DLSS or pendingUpscalingTechnique == gfxsettings.GFX_UPSCALING_TECHNIQUE_DLSS
            if (hasPendingUpscalingChange or hasPendingResourceChange) and involvesDLSS:
                if currentUpscalingTechnique == gfxsettings.GFX_UPSCALING_TECHNIQUE_DLSS and not transitionState['preferenceCaptured']:
                    snapshot = readDLSS5NativeSnapshot()
                    if snapshot is None or snapshot['state'] == 0:
                        logger.error('DLSS5 guard v13: blocked graphics apply because the user NR preference could not be captured')
                        return False
                    gfxsettings._dlss5NRWantedV13 = 'ON' if snapshot['state'] == 2 else 'OFF'
                    transitionState['preferenceCaptured'] = True
                if not ensureDLSS5NeuralRenderingState(False):
                    logger.error('DLSS5 guard v13: blocked graphics apply because NR OFF was not confirmed')
                    return False
                transitionState['needsRearm'] = True
                beforeSettle = readDLSS5NativeSnapshot()
                transitionState['observedSnapshot'] = beforeSettle
                if beforeSettle is None or beforeSettle['state'] != 1:
                    logger.error('DLSS5 guard v13: NR OFF snapshot unavailable before settling')
                    return False
                logger.info('DLSS5 guard v13: waiting 5000 ms after confirmed NR OFF before upscaler or resource changes')
                blue.synchro.SleepWallclock(5000)
                afterSettle = readDLSS5NativeSnapshot()
                rememberManualPreference(afterSettle)
                # ON then OFF is still an interrupted settling period. Check
                # both sequences and the add-on lifetime, not just final OFF.
                if not sameNativeState(beforeSettle, afterSettle):
                    logger.error('DLSS5 guard v13: native state changed during OFF settling; retry the graphics change')
                    return False
            # The pending target can change during the disarm yield. Only an
            # actual entry from a different renderer technique resets manual
            # F6 intent; cancelling an exit while still on DLSS must not.
            latestUpscalingTechnique = gfxsettings.GetPendingOrCurrent(gfxsettings.GFX_UPSCALING_TECHNIQUE)
            upscalingSettings = (gfxsettings.GFX_UPSCALING_TECHNIQUE, gfxsettings.GFX_UPSCALING_SETTING, gfxsettings.GFX_FRAMEGENERATION_ENABLED)
            hasLatestUpscalingChange = any(gfxsettings.GetPendingOrCurrent(key) != gfxsettings.Get(key) for key in upscalingSettings)
            if currentUpscalingTechnique != gfxsettings.GFX_UPSCALING_TECHNIQUE_DLSS and latestUpscalingTechnique == gfxsettings.GFX_UPSCALING_TECHNIQUE_DLSS and hasLatestUpscalingChange:
                gfxsettings._dlss5NRWantedV13 = 'ON'
                # Override a previous OFF even if this burst already captured
                # it on exit. A subsequent stable-DLSS F6 choice is still free.
                transitionState['preferenceCaptured'] = True
            @LOCAL:graphics_commit@


















            targetUpscalingTechnique = @LOCAL:target_getter@
            hasUpscalingChange = @LOCAL:upscaling_condition@
            if hasUpscalingChange:
                transitionState['needsRearm'] = True
                @LOCAL:upscaling_call@
                if not waitForGraphicsDeviceReady(targetUpscalingTechnique):
                    return False
                @LOCAL:panel_refresh@

            @LOCAL:graphics_event@

            hasResourceChange = any(key in changes for key in resourceSettings)
            if hasUpscalingChange or (hasResourceChange and transitionState['needsRearm']):
                if not waitForGraphicsDeviceReady(targetUpscalingTechnique):
                    return False
            @LOCAL:crash_key@
            return True

        @LOCAL:window_guard@

        if getattr(self, '_dlss5GraphicsApplyInProgress', False):
            self._dlss5GraphicsApplyPending = True
            logger.info('DLSS5 guard v13: coalescing a re-entrant graphics apply')
            return
        self._dlss5GraphicsApplyInProgress = True
        gfxsettings._dlss5GraphicsApplyActive = getattr(gfxsettings, '_dlss5GraphicsApplyActive', 0) + 1
        try:
            startupPolls = 0
            while getattr(gfxsettings, '_dlss5StartupBusy', False):
                if startupPolls >= 200:
                    logger.error('DLSS5 guard v13: blocked graphics apply because startup synchronization is still busy; retry the graphics change')
                    return
                blue.synchro.SleepWallclock(50)
                startupPolls += 1
            while True:
                self._dlss5GraphicsApplyPending = False
                if not applyGraphicsSettingsPass():
                    return
                if getattr(self, '_dlss5GraphicsApplyPending', False):
                    logger.info('DLSS5 guard v13: draining coalesced graphics settings before NR re-arm')
                    continue
                if transitionState['needsRearm'] and @LOCAL:target_getter@ == gfxsettings.GFX_UPSCALING_TECHNIQUE_DLSS:
                    # A retry can have no new pending settings after a prior
                    # commit. Readiness must still be confirmed before re-arm.
                    if not waitForGraphicsDeviceReady(gfxsettings.Get(gfxsettings.GFX_UPSCALING_TECHNIQUE)):
                        return
                    rememberManualPreference(readDLSS5NativeSnapshot())
                    preferredNeuralRenderingState = getattr(gfxsettings, '_dlss5NRWantedV13', None)
                    if preferredNeuralRenderingState not in ('ON', 'OFF'):
                        preferredNeuralRenderingState = 'ON'
                        gfxsettings._dlss5NRWantedV13 = 'ON'
                    if preferredNeuralRenderingState == 'ON':
                        beforeRearm = readDLSS5NativeSnapshot()
                        logger.info('DLSS5 guard v13: waiting 3000 ms after the final graphics pass before NR re-arm')
                        blue.synchro.SleepWallclock(3000)
                        # A settings callback may have run during this yield.
                        # Apply it while NR remains OFF, not after re-arming.
                        if getattr(self, '_dlss5GraphicsApplyPending', False):
                            continue
                        afterRearm = readDLSS5NativeSnapshot()
                        rememberManualPreference(afterRearm)
                        if beforeRearm is None or afterRearm is None or afterRearm['state'] == 0 or beforeRearm['addonEpoch'] != afterRearm['addonEpoch']:
                            logger.error('DLSS5 guard v13: native lifetime/state changed before re-arm; retry the graphics change')
                            return
                        # A manual F6 during the yield supersedes the captured
                        # preference. Never toggle back over the latest choice.
                        if not ensureDLSS5NeuralRenderingState(gfxsettings._dlss5NRWantedV13 == 'ON'):
                            logger.error('DLSS5 guard v13: user-preferred NR ON could not be confirmed')
                            return
                        finishTransition()
                        blue.synchro.SleepWallclock(500)
                    else:
                        if not ensureDLSS5NeuralRenderingState(False):
                            logger.error('DLSS5 guard v13: user-preferred NR OFF could not be confirmed')
                            return
                        finishTransition()
                elif @LOCAL:target_getter@ != gfxsettings.GFX_UPSCALING_TECHNIQUE_DLSS:
                    finishTransition()
                # A callback may also arrive during the F6 acknowledgement or
                # its settle delay. The next pass must disarm again if needed.
                if not getattr(self, '_dlss5GraphicsApplyPending', False):
                    break
        finally:
            gfxsettings._dlss5GraphicsApplyActive -= 1
            self._dlss5GraphicsApplyInProgress = False
            self._dlss5GraphicsApplyPending = False
        return
