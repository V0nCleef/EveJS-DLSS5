+extern "C" BOOL WINAPI EveJSDLSS5InjectF6State(HWND window, BOOL down)
+{
+	DWORD process_id = 0;
+	if (window == nullptr || GetWindowThreadProcessId(window, &process_id) == 0 || process_id != GetCurrentProcessId())
+	{
+		reshade::log::message(
+			reshade::log::level::warning,
+			"EveJS DLSS5 control: rejected process-local async F6 %s for window %p in PID %lu.",
+			down != FALSE ? "DOWN" : "UP", window, GetCurrentProcessId());
+		return FALSE;
+	}
+
+	s_evejs_dlss5_f6_override.store(down != FALSE, std::memory_order_release);
+
+	reshade::log::message(
+		reshade::log::level::info,
+		"EveJS DLSS5 control: %s process-local async F6 override for window %p in PID %lu.",
+		down != FALSE ? "armed" : "released", window, GetCurrentProcessId());
+	return TRUE;
+}
