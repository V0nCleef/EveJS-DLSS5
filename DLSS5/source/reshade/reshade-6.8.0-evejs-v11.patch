@@ -0,0 +1,75 @@
+/*
+ * Copyright (C) 2026 EveJS DLSS5 contributors
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#pragma once
+
+#include <cstdint>
+
+namespace reshade::evejs
+{
+
+struct foreground_window
+{
+	std::uintptr_t handle = 0;
+	std::uint32_t process_id = 0;
+};
+
+// The caller serializes this process-local state. No input is generated here.
+// Focus is sampled: an entire away/back transition between polls is invisible.
+class dlss5_f6_policy
+{
+public:
+	static constexpr int key = 0x75; // VK_F6
+	static constexpr std::int16_t down = static_cast<std::int16_t>(0x8000u);
+
+	template <typename Foreground, typename Blocking, typename Physical>
+	bool filter(int virtual_key, bool injected, std::uint32_t process_id,
+		Foreground &&foreground, Blocking &&blocking, Physical &&physical,
+		std::int16_t &result)
+	{
+		if (virtual_key != key)
+			return false; // Do not read or modify anything for non-F6 keys.
+
+		result = 0;
+		if (injected)
+		{
+			// Automatic transitions remain usable in an unfocused/blocked client.
+			// A simultaneously held physical key must not replay after release.
+			_physical_armed = false;
+			result = down;
+			return true;
+		}
+
+		const foreground_window before = foreground();
+		if (before.handle == 0 || before.process_id == 0 ||
+			before.process_id != process_id || blocking())
+		{
+			_physical_armed = false;
+			return true;
+		}
+
+		const std::int16_t state = physical(virtual_key);
+		const foreground_window after = foreground();
+		if (after.handle != before.handle || after.process_id != process_id)
+		{
+			_physical_armed = false;
+			return true;
+		}
+
+		// Ignore the global, unreliable "pressed since last call" low bit.
+		if ((state & 0x8000) == 0)
+			_physical_armed = true;
+		else if (_physical_armed)
+			result = down;
+
+		return true;
+	}
+
+private:
+	// Initial DOWN and a held key after focus loss require a foreground UP.
+	bool _physical_armed = false;
+};
+
+}
