+	const auto loaded = get_module_path(module);
+	const bool expected_identity = !loaded.empty() && std::filesystem::equivalent(expected, loaded, ec) && !ec;
+	s_evejs_nr_state.register_module(reinterpret_cast<std::uintptr_t>(module), expected_identity);
+}
+
+void reshade::evejs::unregister_nr_state_addon(HMODULE module)
+{
+	s_evejs_nr_state.unregister_module(reinterpret_cast<std::uintptr_t>(module));
+}
