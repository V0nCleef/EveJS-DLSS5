diff --git a/source/evejs_dlss5_nr_state.hpp b/source/evejs_dlss5_nr_state.hpp
new file mode 100644
--- /dev/null
+++ b/source/evejs_dlss5_nr_state.hpp
@@ -0,0 +1,118 @@
+/*
+ * EveJS process-local RenoDX state observer. SPDX-License-Identifier: MIT
+ * State is evidence from this process's registered add-on, never key intent.
+ */
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <string_view>
+#include <Windows.h>
+
+struct alignas(8) EveJSNRStateSnapshot
+{
+	std::uint32_t abiVersion;
+	std::uint32_t state; // 0 unknown, 1 OFF, 2 ON
+	std::uint64_t stateSequence;
+	std::uint64_t toggleSequence;
+	std::uint32_t lastToggleState;
+	std::uint32_t addonEpoch;
+};
+static_assert(sizeof(EveJSNRStateSnapshot) == 32);
+static_assert(alignof(EveJSNRStateSnapshot) == 8);
+static_assert(offsetof(EveJSNRStateSnapshot, stateSequence) == 8);
+static_assert(offsetof(EveJSNRStateSnapshot, toggleSequence) == 16);
+static_assert(offsetof(EveJSNRStateSnapshot, addonEpoch) == 28);
+
+extern "C" BOOL WINAPI EveJSDLSS5QueryNRState(HWND window, EveJSNRStateSnapshot *snapshot, DWORD snapshotSize);
+
+namespace reshade::evejs
+{
+	// Header-only production helper also used directly by deterministic tests.
+	class nr_state_tracker
+	{
+	public:
+		static constexpr std::size_t max_message_bytes = 1024;
+
+		bool register_module(std::uintptr_t module, bool expected_identity)
+		{
+			const std::lock_guard<std::mutex> lock(_mutex);
+			if (!module || !expected_identity || module == _module)
+				return false;
+			_module = module;
+			reset_state();
+			return true;
+		}
+		bool unregister_module(std::uintptr_t module)
+		{
+			const std::lock_guard<std::mutex> lock(_mutex);
+			if (!module || module != _module)
+				return false;
+			_module = 0;
+			reset_state();
+			return true;
+		}
+		bool observe(std::uintptr_t module, const char *message)
+		{
+			const std::lock_guard<std::mutex> lock(_mutex);
+			if (!module || module != _module || message == nullptr)
+				return false;
+			std::size_t length = 0;
+			while (length < max_message_bytes && message[length] != '\0')
+			{
+				if (static_cast<unsigned char>(message[length]) < 32 || static_cast<unsigned char>(message[length]) > 126)
+					return false;
+				++length;
+			}
+			if (length == max_message_bytes)
+				return false;
+			const std::string_view text(message, length);
+			std::uint32_t state = 0;
+			bool toggle = false;
+			if (text == "DLSS5 Generic: NR toggled ON via F6")
+				state = 2, toggle = true;
+			else if (text == "DLSS5 Generic: NR toggled OFF via F6")
+				state = 1, toggle = true;
+			else
+			{
+				constexpr std::string_view prefix = "DLSS5 Generic: DLSS5 active settings: upscaling=";
+				constexpr std::string_view enabled = " enabled=";
+				if (text.substr(0, prefix.size()) != prefix)
+					return false;
+				const auto position = text.find(enabled, prefix.size());
+				if (position == std::string_view::npos || position == prefix.size() || text.find(enabled, position + enabled.size()) != std::string_view::npos)
+					return false;
+				const auto value = text.substr(position + enabled.size());
+				if (value == "ON") state = 2;
+				else if (value == "OFF") state = 1;
+				else return false;
+			}
+			_state.state = state;
+			++_state.stateSequence;
+			if (toggle)
+			{
+				++_state.toggleSequence;
+				_state.lastToggleState = state;
+			}
+			return true;
+		}
+		EveJSNRStateSnapshot snapshot()
+		{
+			const std::lock_guard<std::mutex> lock(_mutex);
+			return _state;
+		}
+	private:
+		void reset_state()
+		{
+			_state.state = _state.lastToggleState = 0;
+			++_state.stateSequence;
+			++_state.addonEpoch;
+		}
+		std::mutex _mutex;
+		std::uintptr_t _module = 0;
+		EveJSNRStateSnapshot _state = { 1, 0, 0, 0, 0, 0 };
+	};
+
+	void register_nr_state_addon(HMODULE module);
+	void unregister_nr_state_addon(HMODULE module);
+}
diff --git a/source/evejs_dlss5_nr_state_tests.hpp b/source/evejs_dlss5_nr_state_tests.hpp
new file mode 100644
--- /dev/null
+++ b/source/evejs_dlss5_nr_state_tests.hpp
@@ -0,0 +1,96 @@
+// Hidden test-application checks using the exact production state tracker.
+#pragma once
+#include "evejs_dlss5_nr_state.hpp"
+#include <array>
+#include <cstring>
+
+static bool evejs_dlss5_nr_state_self_test()
+{
+	unsigned checks = 0;
+	auto check = [&](bool condition, const char *label) {
+		++checks;
+		if (!condition) reshade::log::message(reshade::log::level::error, "EveJS V11 NR state FAIL: %s", label);
+		return condition;
+	};
+	reshade::evejs::nr_state_tracker a, b;
+	constexpr auto on = "DLSS5 Generic: NR toggled ON via F6";
+	constexpr auto off = "DLSS5 Generic: NR toggled OFF via F6";
+	constexpr auto active = "DLSS5 Generic: DLSS5 active settings: upscaling=OFF intensity=1.000000 global_tone=1.000000 diffuse_white_nits=203.000000 preset=0 style=0 enabled=ON";
+	if (!check(a.snapshot().abiVersion == 1 && a.snapshot().state == 0 && a.snapshot().addonEpoch == 0, "initial unknown") ||
+		!check(!a.register_module(0, true), "null registration") ||
+		!check(!a.register_module(10, false), "wrong identity") ||
+		!check(!a.observe(10, on), "unregistered message") ||
+		!check(a.register_module(10, true), "valid registration")) return false;
+	auto initial = a.snapshot();
+	if (!check(initial.addonEpoch == 1 && initial.stateSequence == 1 && initial.toggleSequence == 0, "registration epoch") ||
+		!check(!a.register_module(10, true), "duplicate registration preserves state") ||
+		!check(a.observe(10, active), "authentic initial active settings")) return false;
+	auto known = a.snapshot();
+	if (!check(known.state == 2 && known.stateSequence == 2 && known.toggleSequence == 0 && known.lastToggleState == 0, "snapshot is not toggle acknowledgement")) return false;
+	const char *bad[] = {
+		nullptr, "", "NR toggled OFF via F6", "DLSS5 Generic: NR toggled OFF via F6 trailing",
+		"DLSS5 Generic: NR toggled off via F6", "DLSS5 Generic: NR toggled OFF via F6\n",
+		"prefix DLSS5 Generic: NR toggled OFF via F6",
+		"DLSS5 Generic: DLSS5 active settings: upscaling=OFF enabled=OFF spoof",
+		"DLSS5 Generic: DLSS5 active settings: upscaling=OFF enabled=OFF enabled=ON",
+		"DLSS5 Generic: DLSS5 active settings: upscaling= enabled=OFF",
+		"DLSS5 Generic: DLSS5 active settings: upscaling=OFF enabled=UNKNOWN",
+		"DLSS5 Generic: DLSS5 active settings: upscaling=OFF enabled=OFF\r\n",
+		"DLSS5 Generic: DLSS5 active settings: upscaling=OFF notenabled=OFF"
+	};
+	for (auto message : bad)
+		if (!check(!a.observe(10, message), "invalid message rejected")) return false;
+	std::array<char, reshade::evejs::nr_state_tracker::max_message_bytes> oversized;
+	oversized.fill('x');
+	if (!check(!a.observe(10, oversized.data()), "bounded nonterminated message") ||
+		!check(!a.observe(20, off), "wrong registered module") ||
+		!check(!a.observe(0, off), "null module") ||
+		!check(!a.unregister_module(20), "wrong unregister")) return false;
+	auto unchanged = a.snapshot();
+	if (!check(std::memcmp(&known, &unchanged, sizeof(known)) == 0, "rejections cannot change snapshot") ||
+		!check(a.observe(10, off), "first real toggle acknowledgement")) return false;
+	auto toggled = a.snapshot();
+	if (!check(toggled.state == 1 && toggled.lastToggleState == 1 && toggled.toggleSequence == 1 && toggled.stateSequence == 3, "toggle counters") ||
+		!check(a.observe(10, on), "second real toggle") ||
+		!check(a.snapshot().toggleSequence == 2 && a.snapshot().state == 2, "second toggle counters") ||
+		!check(b.register_module(20, true) && b.observe(20, off), "independent process fixture") ||
+		!check(a.snapshot().state == 2 && a.snapshot().toggleSequence == 2 && b.snapshot().state == 1 && b.snapshot().toggleSequence == 1, "independent state") ||
+		!check(a.observe(10, active) && a.snapshot().toggleSequence == 2, "active snapshot never acknowledges injected key") ||
+		!check(a.register_module(30, true), "module replacement") ||
+		!check(a.snapshot().state == 0 && a.snapshot().addonEpoch == 2 && a.snapshot().lastToggleState == 0, "replacement invalidates known state") ||
+		!check(!a.observe(10, off) && !a.unregister_module(10), "old epoch module rejected") ||
+		!check(a.observe(30, off) && a.snapshot().toggleSequence == 3, "replacement fresh acknowledgement") ||
+		!check(a.unregister_module(30), "correct unregister") ||
+		!check(a.snapshot().state == 0 && a.snapshot().addonEpoch == 3 && a.snapshot().lastToggleState == 0 && a.snapshot().toggleSequence == 3, "unregister resets state but not monotonic sequence") ||
+		!check(!a.observe(30, on) && !a.unregister_module(30), "unloaded module cannot revive state") ||
+		!check(b.snapshot().state == 1 && b.snapshot().toggleSequence == 1, "other fixture survives unload")) return false;
+	reshade::log::message(reshade::log::level::info, "EveJS V11 NR state production tracker PASS: %u deterministic checks; no files, input or focus changes.", checks);
+	return true;
+}
+
+static bool evejs_dlss5_nr_export_self_test(HWND owned_window, HMODULE own_module)
+{
+	using query_type = BOOL (WINAPI *)(HWND, EveJSNRStateSnapshot *, DWORD);
+	const auto query = reinterpret_cast<query_type>(GetProcAddress(own_module, "EveJSDLSS5QueryNRState"));
+	if (query == nullptr) return false;
+	EveJSNRStateSnapshot state;
+	std::memset(&state, 0x7f, sizeof(state));
+	if (query(owned_window, nullptr, sizeof(state)) || query(nullptr, &state, sizeof(state)) || state.abiVersion != 0) return false;
+	for (DWORD size : { 0u, 4u, 31u, 33u })
+	{
+		std::array<unsigned char, 40> buffer;
+		buffer.fill(0x7f);
+		if (query(owned_window, reinterpret_cast<EveJSNRStateSnapshot *>(buffer.data()), size)) return false;
+		for (std::size_t i = 0; i < buffer.size(); ++i)
+			if (buffer[i] != (i < size && i < sizeof(state) ? 0 : 0x7f)) return false;
+	}
+	const HWND desktop = GetDesktopWindow();
+	DWORD desktop_pid = 0;
+	GetWindowThreadProcessId(desktop, &desktop_pid);
+	if (desktop_pid != GetCurrentProcessId() && query(desktop, &state, sizeof(state))) return false;
+	if (!query(owned_window, &state, sizeof(state)) || state.abiVersion != 1 || state.state != 0 || state.stateSequence != 0 || state.toggleSequence != 0 || state.addonEpoch != 0) return false;
+	const auto original = state;
+	if (!query(owned_window, &state, sizeof(state)) || std::memcmp(&state, &original, sizeof(state)) != 0) return false;
+	reshade::log::message(reshade::log::level::info, "EveJS V11 NR readonly export PASS: owned hidden HWND, null/size/foreign-window rejection, zeroing bounds, initial UNKNOWN, repeated read does not mutate.");
+	return true;
+}
